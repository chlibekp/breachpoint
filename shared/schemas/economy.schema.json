{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "economy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "startCredits", "maxCredits", "killReward", "roundWin", "roundLossStreak", "plantTeamReward", "shields", "ultimatePoints"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "startCredits": { "type": "integer", "minimum": 0 },
    "maxCredits": { "type": "integer", "minimum": 0 },
    "killReward": { "type": "integer", "minimum": 0 },
    "roundWin": { "type": "integer", "minimum": 0 },
    "roundLossStreak": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
    "plantTeamReward": { "type": "integer", "minimum": 0 },
    "shields": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "cost", "amount", "absorb"],
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" }, "cost": { "type": "integer", "minimum": 0 },
          "amount": { "type": "integer", "minimum": 0 }, "absorb": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "ultimatePoints": {
      "type": "object", "additionalProperties": false, "required": ["kill", "death", "plant", "defuse", "riftOrb", "riftOrbsPerMap"],
      "properties": {
        "kill": { "type": "integer" }, "death": { "type": "integer" }, "plant": { "type": "integer" },
        "defuse": { "type": "integer" }, "riftOrb": { "type": "integer" }, "riftOrbsPerMap": { "type": "integer" }
      }
    }
  }
}
