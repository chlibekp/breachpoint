{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skins.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "skins"],
  "properties": {
    "$schema": { "type": "string" },
    "comment": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "skins": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "base_color", "metal_color", "accent", "emissive_color", "emissive_energy", "base_roughness", "metal_roughness", "clearcoat_amount"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string" },
          "base_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "metal_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "accent": { "type": "string", "pattern": "^(class|#[0-9A-Fa-f]{6})$" },
          "emissive_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "emissive_energy": { "type": "number", "minimum": 0 },
          "base_roughness": { "type": "number", "minimum": 0, "maximum": 1 },
          "metal_roughness": { "type": "number", "minimum": 0, "maximum": 1 },
          "clearcoat_amount": { "type": "number", "minimum": 0, "maximum": 1 },
          "stripes": { "type": "boolean" }
        }
      }
    }
  }
}
