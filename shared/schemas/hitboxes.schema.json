{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hitboxes.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "crouchScale", "zones", "capsules"],
  "properties": {
    "$schema": { "type": "string" },
    "comment": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "crouchScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "zones": { "type": "object" },
    "capsules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "zone", "a", "b", "r"],
        "properties": {
          "name": { "type": "string" },
          "zone": { "enum": ["head", "upper_torso", "lower_torso", "arm", "leg"] },
          "a": { "$ref": "#/$defs/v3" }, "b": { "$ref": "#/$defs/v3" },
          "r": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  },
  "$defs": { "v3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } } }
}
