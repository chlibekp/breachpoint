{
  "$comment": "BREACHPOINT wire protocol. Edit this file, then run `npm run protocol:gen` to regenerate the TypeScript and GDScript codecs. Never edit generated files by hand.",
  "version": 1,
  "primitives": {
    "u8": "unsigned 8-bit",
    "u16": "unsigned 16-bit LE",
    "u32": "unsigned 32-bit LE",
    "i8": "signed 8-bit",
    "i16": "signed 16-bit LE",
    "i32": "signed 32-bit LE",
    "f32": "IEEE754 float LE",
    "bool": "u8 0/1",
    "string": "u16 byte length + UTF-8",
    "pos": "Vec3 metres, each axis i32 millimetres",
    "vel": "Vec3 m/s, each axis i16 at 1/1000 m/s (clamped to ±32.767)",
    "angle": "radians, u16 turn fraction (65536 = 2π), decoded to (-π, π]",
    "bytes": "u16 length + raw bytes"
  },
  "structs": {
    "InputCmd": [
      {
        "name": "seq",
        "type": "u32"
      },
      {
