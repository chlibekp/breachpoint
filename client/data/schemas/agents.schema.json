{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents.schema.json",
  "type": "object",
  "required": ["version", "roles", "agents"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "roles": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "description"],
        "properties": { "id": { "enum": ["vanguard", "shroud", "seeker", "warden"] }, "name": { "type": "string" }, "description": { "type": "string" } }
      }
    },
    "agents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/agent" } }
  },
  "$defs": {
    "ability": {
      "type": "object", "additionalProperties": false,
      "required": ["slot", "id", "name", "castType", "cost", "charges", "castTime", "params"],
      "properties": {
        "slot": { "enum": ["C", "Q", "E", "X"] },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "castType": { "enum": ["instant", "throwable", "placeable", "aimed"] },
        "cost": { "type": "integer", "minimum": 0 },
        "ultPoints": { "type": "integer", "minimum": 6, "maximum": 8 },
        "charges": { "type": "integer", "minimum": 1, "maximum": 3 },
        "castTime": { "type": "number", "minimum": 0 },
        "recharge": {
          "type": "object", "additionalProperties": false, "required": ["type", "amount"],
          "properties": { "type": { "enum": ["timer", "kills"] }, "amount": { "type": "number", "minimum": 0 } }
        },
        "params": { "type": "object" }
      }
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "role", "origin", "bio", "signatureColor", "silhouette", "abilities"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["vanguard", "shroud", "seeker", "warden"] },
        "origin": { "type": "string" },
        "bio": { "type": "string" },
        "signatureColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "silhouette": { "type": "string" },
        "abilities": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/ability" } }
      }
    }
  }
}
